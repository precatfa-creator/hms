 "html": "{%- macro d(v) -%}{{ frappe.utils.formatdate(v) if v else \"\" }}{%- endmacro -%}\n{%- macro chk(cond) -%}{{ \"&#9746;\" if cond else \"&#9744;\" }}{%- endmacro -%}\n{%- macro cell(en, ar, val, span=1) -%}\n<td colspan=\"{{ span }}\"><div class=\"lbl\"><span class=\"en\">{{ en }}</span><span class=\"ar\">{{ ar }}</span></div><div class=\"val\">{{ val or \"&nbsp;\" }}</div></td>\n{%- endmacro -%}\n{%- macro party(prefix, en_title, ar_title) -%}\n<td style=\"width:50%\">\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"2\"><span class=\"en\">{{ en_title }}</span><span class=\"ar\">{{ ar_title }}</span></td></tr>\n\t\t<tr>{{ cell(\"Full Name\", \"&#1575;&#1604;&#1575;&#1587;&#1605; &#1603;&#1575;&#1605;&#1604;\", (doc.get(prefix ~ \"_name_en\") or \"\") ~ \" / \" ~ (doc.get(prefix ~ \"_name_ar\") or \"\"), 2) }}</tr>\n\t\t<tr>{{ cell(\"National ID / Passport No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1607;&#1608;&#1610;&#1577; / &#1580;&#1608;&#1575;&#1586; &#1575;&#1604;&#1587;&#1601;&#1585;\", doc.get(prefix ~ \"_national_id\"), 2) }}</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Address\", \"&#1575;&#1604;&#1593;&#1606;&#1608;&#1575;&#1606;\", doc.get(prefix ~ \"_address\")) }}\n\t\t\t{{ cell(\"City\", \"&#1575;&#1604;&#1605;&#1583;&#1610;&#1606;&#1577;\", doc.get(prefix ~ \"_city\")) }}\n\t\t</tr>\n\t\t<tr>{{ cell(\"Phone No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1607;&#1575;&#1578;&#1601;\", doc.get(prefix ~ \"_phone\"), 2) }}</tr>\n\t</table>\n</td>\n{%- endmacro -%}\n\n<div class=\"lha\">\n\t<table class=\"head\">\n\t\t<tr>\n\t\t\t<td class=\"en\" style=\"width:22%\">\n\t\t\t\t<div class=\"org-en\">Libyan Authority for Horse Racing</div>\n\t\t\t\t<div class=\"org-en\">Libyan Stud Book Department</div>\n\t\t\t\t<div class=\"org-en\">Horse Transfer of Ownership Form</div>\n\t\t\t</td>\n\t\t\t<td class=\"ar\" style=\"width:56%\">\n\t\t\t\t<div class=\"org-ar\">&#1575;&#1604;&#1607;&#1610;&#1574;&#1577; &#1575;&#1604;&#1604;&#1610;&#1576;&#1610;&#1577; &#1604;&#1587;&#1576;&#1575;&#1602; &#1575;&#1604;&#1582;&#1610;&#1604;</div>\n\t\t\t\t<div class=\"org-ar\">&#1573;&#1583;&#1575;&#1585;&#1577; &#1603;&#1578;&#1575;&#1576; &#1575;&#1604;&#1571;&#1606;&#1587;&#1575;&#1576;</div>\n\t\t\t\t<div class=\"org-ar\">&#1606;&#1605;&#1608;&#1584;&#1580; &#1578;&#1606;&#1575;&#1586;&#1604; &#1580;&#1608;&#1575;&#1583;</div>\n\t\t\t</td>\n\t\t\t<td class=\"ar\" style=\"width:22%\">\n\t\t\t\t<div class=\"org-ar\">&#1573;&#1583;&#1575;&#1585;&#1577; &#1587;&#1580;&#1604; &#1575;&#1604;&#1571;&#1606;&#1587;&#1575;&#1576;</div>\n\t\t\t\t<div class=\"org-en\">Studbook Department</div>\n\t\t\t\t<div class=\"serial\">{{ doc.name }}</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"4\"><span class=\"en\">Horse Information</span><span class=\"ar\">&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1580;&#1608;&#1575;&#1583;</span></td></tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Horse's Name\", \"&#1575;&#1587;&#1605; &#1575;&#1604;&#1580;&#1608;&#1575;&#1583;\", (doc.horse_name_en or \"\") ~ \" / \" ~ (doc.horse_name_ar or \"\"), 2) }}\n\t\t\t{{ cell(\"Registration No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1578;&#1587;&#1580;&#1610;&#1604;\", doc.horse) }}\n\t\t\t{{ cell(\"UELN No\", \"&#1575;&#1604;&#1585;&#1602;&#1605; &#1575;&#1604;&#1593;&#1575;&#1604;&#1605;&#1610; &#1604;&#1604;&#1582;&#1610;&#1608;&#1604;\", doc.ueln_no) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Date of Birth\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1575;&#1604;&#1605;&#1610;&#1604;&#1575;&#1583;\", d(doc.date_of_birth), 2) }}\n\t\t\t{{ cell(\"Place of Birth\", \"&#1605;&#1603;&#1575;&#1606; &#1575;&#1604;&#1605;&#1610;&#1604;&#1575;&#1583;\", doc.place_of_birth, 2) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Sex\", \"&#1575;&#1604;&#1580;&#1606;&#1587;\", chk(doc.gender == \"Male\") ~ \" Male / &#1584;&#1603;&#1585; &nbsp; \" ~ chk(doc.gender == \"Female\") ~ \" Female / &#1571;&#1606;&#1579;&#1609; &nbsp; \" ~ chk(doc.gender == \"Gelding\") ~ \" Gelding / &#1605;&#1582;&#1589;&#1610;\", 2) }}\n\t\t\t{{ cell(\"Color\", \"&#1575;&#1604;&#1604;&#1608;&#1606;\", doc.color, 2) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Sire\", \"&#1575;&#1587;&#1605; &#1575;&#1604;&#1571;&#1576;\", (doc.sire_name_en or \"\") ~ \" (\" ~ (doc.sire_registration_no or \"\") ~ \")\", 2) }}\n\t\t\t{{ cell(\"Dam\", \"&#1575;&#1587;&#1605; &#1575;&#1604;&#1571;&#1605;\", (doc.dam_name_en or \"\") ~ \" (\" ~ (doc.dam_registration_no or \"\") ~ \")\", 2) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Microchip No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1588;&#1585;&#1610;&#1581;&#1577;\", doc.microchip_no, 2) }}\n\t\t\t{{ cell(\"Country of Origin\", \"&#1576;&#1604;&#1583; &#1575;&#1604;&#1605;&#1606;&#1588;&#1571;\", doc.origin, 2) }}\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr>\n\t\t\t{{ party(\"current_owner\", \"Transferor Information (Current Owner)\", \"&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1605;&#1575;&#1604;&#1603; &#1575;&#1604;&#1581;&#1575;&#1604;&#1610;\") }}\n\t\t\t{{ party(\"new_owner\", \"Transferee Information (New Owner)\", \"&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1605;&#1575;&#1604;&#1603; &#1575;&#1604;&#1580;&#1583;&#1610;&#1583;\") }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Horse Ownership Date\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1578;&#1605;&#1604;&#1603; &#1575;&#1604;&#1580;&#1608;&#1575;&#1583;\", d(doc.current_ownership_date)) }}\n\t\t\t{{ cell(\"Horse Ownership Date\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1578;&#1605;&#1604;&#1603; &#1575;&#1604;&#1580;&#1608;&#1575;&#1583;\", d(doc.new_ownership_date)) }}\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"2\"><span class=\"en\">Note</span><span class=\"ar\">&#1578;&#1606;&#1608;&#1610;&#1607;</span></td></tr>\n\t\t<tr>\n\t\t\t<td class=\"note\" style=\"width:50%\">\n\t\t\t\t<ol>\n\t\t\t\t\t<li>All fields must be completed, and both parties must sign the form.</li>\n\t\t\t\t\t<li>The seller and the buyer must provide a copy of their passport when applying to the Stud Book Department.</li>\n\t\t\t\t\t<li>The form must be signed and endorsed by a licensed legal contract officer.</li>\n\t\t\t\t\t<li>This form, duly endorsed by the legal contract officer, must be submitted to the Stud Book Department.</li>\n\t\t\t\t\t<li>The current owner is entitled to complete all legal procedures, including sale, purchase, transfer of ownership, and assignment.</li>\n\t\t\t\t</ol>\n\t\t\t</td>\n\t\t\t<td class=\"note ar\" style=\"width:50%\">\n\t\t\t\t<ol class=\"rtl\">\n\t\t\t\t\t<li>&#1610;&#1588;&#1578;&#1585;&#1591; &#1578;&#1593;&#1576;&#1574;&#1577; &#1580;&#1605;&#1610;&#1593; &#1575;&#1604;&#1582;&#1575;&#1606;&#1575;&#1578; &#1608;&#1573;&#1585;&#1601;&#1575;&#1602; &#1578;&#1608;&#1602;&#1610;&#1593; &#1603;&#1604;&#1575; &#1575;&#1604;&#1591;&#1585;&#1601;&#1610;&#1606;.</li>\n\t\t\t\t\t<li>&#1610;&#1580;&#1576; &#1593;&#1604;&#1609; &#1575;&#1604;&#1576;&#1575;&#1574;&#1593; &#1608;&#1575;&#1604;&#1605;&#1588;&#1578;&#1585;&#1610; &#1573;&#1581;&#1590;&#1575;&#1585; &#1589;&#1608;&#1585;&#1577; &#1605;&#1606; &#1580;&#1608;&#1575;&#1586; &#1575;&#1604;&#1587;&#1601;&#1585; &#1593;&#1606;&#1583; &#1575;&#1604;&#1578;&#1602;&#1583;&#1605; &#1573;&#1604;&#1609; &#1573;&#1583;&#1575;&#1585;&#1577; &#1587;&#1580;&#1604; &#1575;&#1604;&#1571;&#1606;&#1587;&#1575;&#1576;.</li>\n\t\t\t\t\t<li>&#1610;&#1588;&#1578;&#1585;&#1591; &#1571;&#1606; &#1610;&#1578;&#1605; &#1578;&#1608;&#1602;&#1610;&#1593; &#1608;&#1575;&#1593;&#1578;&#1605;&#1575;&#1583; &#1575;&#1604;&#1606;&#1605;&#1608;&#1584;&#1580; &#1605;&#1606; &#1605;&#1581;&#1585;&#1585; &#1593;&#1602;&#1608;&#1583; &#1602;&#1575;&#1606;&#1608;&#1606;&#1610; &#1605;&#1593;&#1578;&#1605;&#1583;.</li>\n\t\t\t\t\t<li>&#1610;&#1580;&#1576; &#1573;&#1581;&#1590;&#1575;&#1585; &#1607;&#1584;&#1575; &#1575;&#1604;&#1606;&#1605;&#1608;&#1584;&#1580; &#1605;&#1593;&#1578;&#1605;&#1583;&#1611;&#1575; &#1605;&#1606; &#1605;&#1581;&#1585;&#1585; &#1575;&#1604;&#1593;&#1602;&#1608;&#1583; &#1593;&#1606;&#1583; &#1575;&#1604;&#1578;&#1602;&#1583;&#1605; &#1573;&#1604;&#1609; &#1573;&#1583;&#1575;&#1585;&#1577; &#1587;&#1580;&#1604; &#1575;&#1604;&#1571;&#1606;&#1587;&#1575;&#1576;.</li>\n\t\t\t\t\t<li>&#1610;&#1581;&#1602; &#1604;&#1604;&#1605;&#1575;&#1604;&#1603; &#1575;&#1604;&#1581;&#1575;&#1604;&#1610; &#1573;&#1578;&#1605;&#1575;&#1605; &#1603;&#1604; &#1575;&#1604;&#1573;&#1580;&#1585;&#1575;&#1569;&#1575;&#1578; &#1575;&#1604;&#1602;&#1575;&#1606;&#1608;&#1606;&#1610;&#1577; &#1576;&#1605;&#1575; &#1601;&#1610;&#1607;&#1575; &#1575;&#1604;&#1576;&#1610;&#1593; &#1608;&#1575;&#1604;&#1588;&#1585;&#1575;&#1569; &#1608;&#1606;&#1602;&#1604; &#1575;&#1604;&#1605;&#1604;&#1603;&#1610;&#1577; &#1608;&#1575;&#1604;&#1578;&#1606;&#1575;&#1586;&#1604;.</li>\n\t\t\t\t</ol>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr>\n\t\t\t<td class=\"sign\">\n\t\t\t\t<div class=\"en\">New Owner's Signature</div>\n\t\t\t\t<div class=\"ar\">&#1578;&#1608;&#1602;&#1610;&#1593; &#1575;&#1604;&#1605;&#1575;&#1604;&#1603; &#1575;&#1604;&#1580;&#1583;&#1610;&#1583;</div>\n\t\t\t\t<div class=\"dots\">........................................</div>\n\t\t\t</td>\n\t\t\t<td class=\"sign val\">\n\t\t\t\t<div class=\"lbl\"><span class=\"en\">Date</span><span class=\"ar\">&#1575;&#1604;&#1578;&#1575;&#1585;&#1610;&#1582;</span></div>\n\t\t\t\t<div class=\"dots\">{{ d(doc.new_ownership_date) }}</div>\n\t\t\t</td>\n\t\t\t<td class=\"sign\">\n\t\t\t\t<div class=\"en\">Current Owner's Signature</div>\n\t\t\t\t<div class=\"ar\">&#1578;&#1608;&#1602;&#1610;&#1593; &#1575;&#1604;&#1605;&#1575;&#1604;&#1603; &#1575;&#1604;&#1581;&#1575;&#1604;&#1610;</div>\n\t\t\t\t<div class=\"dots\">........................................</div>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"sign\">\n\t\t\t\t<div class=\"en\">Legal Contract Officer's Endorsement &amp; Signature</div>\n\t\t\t\t<div class=\"ar\"