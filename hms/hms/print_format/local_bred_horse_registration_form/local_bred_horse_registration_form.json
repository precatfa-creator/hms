 "html": "{%- macro d(v) -%}{{ frappe.utils.formatdate(v) if v else \"\" }}{%- endmacro -%}\n{%- macro chk(cond) -%}{{ \"&#9746;\" if cond else \"&#9744;\" }}{%- endmacro -%}\n{%- macro cell(en, ar, val, span=1) -%}\n<td colspan=\"{{ span }}\"><div class=\"lbl\"><span class=\"en\">{{ en }}</span><span class=\"ar\">{{ ar }}</span></div><div class=\"val\">{{ val or \"&nbsp;\" }}</div></td>\n{%- endmacro -%}\n\n<div class=\"lha\">\n\t<table class=\"head\">\n\t\t<tr>\n\t\t\t<td class=\"en\" style=\"width:22%\">\n\t\t\t\t<div class=\"org-en\">Libyan Authority for Horse Racing</div>\n\t\t\t\t<div class=\"org-en\">Libyan Stud Book Department</div>\n\t\t\t\t<div class=\"org-en\">Local-Bred Horse Registration Form</div>\n\t\t\t</td>\n\t\t\t<td class=\"ar\" style=\"width:56%\">\n\t\t\t\t<div class=\"org-ar\">&#1575;&#1604;&#1607;&#1610;&#1574;&#1577; &#1575;&#1604;&#1604;&#1610;&#1576;&#1610;&#1577; &#1604;&#1587;&#1576;&#1575;&#1602; &#1575;&#1604;&#1582;&#1610;&#1604;</div>\n\t\t\t\t<div class=\"org-ar\">&#1573;&#1583;&#1575;&#1585;&#1577; &#1603;&#1578;&#1575;&#1576; &#1575;&#1604;&#1571;&#1606;&#1587;&#1575;&#1576;</div>\n\t\t\t\t<div class=\"org-ar\">&#1606;&#1605;&#1608;&#1584;&#1580; &#1578;&#1587;&#1580;&#1610;&#1604; &#1580;&#1608;&#1575;&#1583; &#1573;&#1606;&#1578;&#1575;&#1580; &#1605;&#1581;&#1604;&#1610;</div>\n\t\t\t</td>\n\t\t\t<td class=\"ar\" style=\"width:22%\">\n\t\t\t\t<div class=\"org-ar\">&#1573;&#1583;&#1575;&#1585;&#1577; &#1587;&#1580;&#1604; &#1575;&#1604;&#1571;&#1606;&#1587;&#1575;&#1576;</div>\n\t\t\t\t<div class=\"org-en\">Studbook Department</div>\n\t\t\t\t<div class=\"serial\">{{ doc.name }}</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"4\"><span class=\"en\">Owner's Data</span><span class=\"ar\">&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1605;&#1575;&#1604;&#1603;</span></td></tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Owner's Name\", \"&#1575;&#1587;&#1605; &#1575;&#1604;&#1605;&#1575;&#1604;