75;&#1604;&#1577;\", doc.sire_breed) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Microchip No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1585;&#1602;&#1575;&#1602;&#1577; &#1575;&#1604;&#1573;&#1604;&#1603;&#1578;&#1585;&#1608;&#1606;&#1610;&#1577;\", doc.sire_microchip_no, 4) }}\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"4\"><span class=\"en\">Dam's Data</span><span class=\"ar\">&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1571;&#1605;</span></td></tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Dam's Name\", \"&#1575;&#1587;&#1605; &#1575;&#1604;&#1571;&#1605;\", (doc.dam_name_en or \"\") ~ \" / \" ~ (doc.dam_name_ar or \"\"), 2) }}\n\t\t\t{{ cell(\"Registration No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1578;&#1587;&#1580;&#1610;&#1604;\", doc.dam_registration_no) }}\n\t\t\t{{ cell(\"Country of Origin\", \"&#1576;&#1604;&#1583; &#1575;&#1604;&#1605;&#1606;&#1588;&#1571;\", chk(doc.dam_origin == \"Imported\") ~ \" Imported / &#1605;&#1587;&#1578;&#1608;&#1585;&#1583; &nbsp; \" ~ chk(doc.dam_origin == \"Local\") ~ \" Local / &#1605;&#1581;&#1604;&#1610;\") }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Date of Birth\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1575;&#1604;&#1605;&#1610;&#1604;&#1575;&#1583;\", d(doc.dam_date_of_birth)) }}\n\t\t\t{{ cell(\"Place of Birth\", \"&#1605;&#1603;&#1575;&#1606; &#1575;&#1604;&#1605;&#1610;&#1604;&#1575;&#1583;\", doc.dam_place_of_birth) }}\n\t\t\t{{ cell(\"Color\", \"&#1575;&#1604;&#1604;&#1608;&#1606;\", doc.dam_color) }}\n\t\t\t{{ cell(\"Breed\", \"&#1575;&#1604;&#1587;&#1604;&#1575;&#1604;&#1577;\", doc.dam_breed) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Status of Life\", \"&#1581;&#1575;&#1604;&#1577; &#1575;&#1604;&#1581;&#1610;&#1575;&#1577;\", chk(doc.dam_life_status == \"Alive\") ~ \" Alive / &#1581;&#1610; &nbsp; \" ~ chk(doc.dam_life_status == \"Deceased\") ~ \" Deceased / &#1606;&#1575;&#1601;&#1602;\", 2) }}\n\t\t\t{{ cell(\"Current location of Dam\", \"&#1605;&#1603;&#1575;&#1606; &#1578;&#1608;&#1575;&#1580;&#1583; &#1575;&#1604;&#1571;&#1605; &#1581;&#1575;&#1604;&#1610;&#1575;\", doc.dam_current_location, 2) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Microchip No\", \"&#1585;&#1602;&#1605; &#1575;&#1604;&#1585;&#1602;&#1575;&#1602;&#1577; &#1575;&#1604;&#1573;&#1604;&#1603;&#1578;&#1585;&#1608;&#1606;&#1610;&#1577;\", doc.dam_microchip_no, 2) }}\n\t\t\t{{ cell(\"Location of Covering\", \"&#1605;&#1603;&#1575;&#1606; &#1575;&#1604;&#1606;&#1586;&#1608;\", chk(doc.covering_location == \"Local\") ~ \" Local / &#1583;&#1575;&#1582;&#1604;&#1610; &nbsp; \" ~ chk(doc.covering_location == \"External\") ~ \" External / &#1582;&#1575;&#1585;&#1580;&#1610;\", 2) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Date of 1st Covering\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1571;&#1608;&#1604; &#1606;&#1586;&#1608;\", d(doc.covering_date_1), 2) }}\n\t\t\t{{ cell(\"Date of 2nd Covering\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1579;&#1575;&#1606;&#1610; &#1606;&#1586;&#1608;\", d(doc.covering_date_2), 2) }}\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"4\"><span class=\"en\">Horse's Data</span><span class=\"ar\">&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1605;&#1608;&#1604;&#1608;&#1583;</span></td></tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Sex\", \"&#1575;&#1604;&#1580;&#1606;&#1587;\", chk(doc.gender == \"Male\") ~ \" Male / &#1584;&#1603;&#1585; &nbsp; \" ~ chk(doc.gender == \"Female\") ~ \" Female / &#1571;&#1606;&#1579;&#1609;\") }}\n\t\t\t{{ cell(\"Place of Birth\", \"&#1605;&#1603;&#1575;&#1606; &#1575;&#1604;&#1605;&#1610;&#1604;&#1575;&#1583;\", doc.place_of_birth) }}\n\t\t\t{{ cell(\"Color\", \"&#1575;&#1604;&#1604;&#1608;&#1606;\", doc.color) }}\n\t\t\t{{ cell(\"Breed\", \"&#1575;&#1604;&#1587;&#1604;&#1575;&#1604;&#1577;\", doc.breed) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Date of Birth\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1575;&#1604;&#1605;&#1610;&#1604;&#1575;&#1583;\", d(doc.date_of_birth), 2) }}\n\t\t\t{{ cell(\"Status of Life\", \"&#1581;&#1575;&#1604;&#1577; &#1575;&#1604;&#1581;&#1610;&#1575;&#1577;\", chk(doc.life_status == \"Alive\") ~ \" Alive / &#1581;&#1610; &nbsp; \" ~ chk(doc.life_status == \"Deceased\") ~ \" Deceased / &#1606;&#1575;&#1601;&#1602;\", 2) }}\n\t\t</tr>\n\t\t<tr>\n\t\t\t{{ cell(\"Current location of Horse\", \"&#1605;&#1603;&#1575;&#1606; &#1578;&#1608;&#1575;&#1580;&#1583; &#1575;&#1604;&#1580;&#1608;&#1575;&#1583; &#1581;&#1575;&#1604;&#1610;&#1575;\", doc.current_location, 2) }}\n\t\t\t{{ cell(\"Notification Date\", \"&#1578;&#1575;&#1585;&#1610;&#1582; &#1575;&#1604;&#1573;&#1576;&#1604;&#1575;&#1594;\", d(doc.notification_date), 2) }}\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr class=\"bar\"><td colspan=\"3\">\n\t\t\t<span class=\"en\">Proposed Names in Arabic and English (in Order of Priority)</span>\n\t\t\t<span class=\"ar\">&#1575;&#1604;&#1571;&#1587;&#1605;&#1575;&#1569; &#1575;&#1604;&#1605;&#1602;&#1578;&#1585;&#1581;&#1577; &#1576;&#1575;&#1604;&#1604;&#1594;&#1578;&#1610;&#1606; &#1575;&#1604;&#1593;&#1585;&#1576;&#1610;&#1577; &#1608;&#1575;&#1604;&#1573;&#1606;&#1580;&#1604;&#1610;&#1586;&#1610;&#1577; &#1581;&#1587;&#1576; &#1575;&#1604;&#1571;&#1608;&#1604;&#1608;&#1610;&#1577;</span>\n\t\t</td></tr>\n\t\t{% for i in [1, 2, 3] %}\n\t\t<tr>\n\t\t\t<td style=\"width:6%\" class=\"val\">{{ i }}</td>\n\t\t\t<td class=\"val\">{{ doc.get(\"name_\" ~ i ~ \"_en\") or \"&nbsp;\" }}</td>\n\t\t\t<td class=\"val ar\">{{ doc.get(\"name_\" ~ i ~ \"_ar\") or \"&nbsp;\" }}</td>\n\t\t</tr>\n\t\t{% endfor %}\n\t\t{% if doc.approved_name_en or doc.approved_name_ar %}\n\t\t<tr class=\"bar\">\n\t\t\t<td><span class=\"en\">Approved</span></td>\n\t\t\t<td class=\"val\">{{ doc.approved_name_en }}</td>\n\t\t\t<td class=\"val ar\">{{ doc.approved_name_ar }}</td>\n\t\t</tr>\n\t\t{% endif %}\n\t</table>\n\n\t<table>\n\t\t<tr>\n\t\t\t<td style=\"width:50%\">\n\t\t\t\t<div class=\"en\">I hereby declare that I bear full legal responsibility for the accuracy and 