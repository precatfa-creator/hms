  {
   "fieldname": "col_connection",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "studbook_enabled",
   "fieldname": "studbook_database",
   "fieldtype": "Data",
   "label": "Database"
  },
  {
   "depends_on": "studbook_enabled",
   "description": "A read-only role is enough, and is what this should be.",
