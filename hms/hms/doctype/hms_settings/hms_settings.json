   "fieldname": "sync_time",
   "fieldtype": "Time",
   "label": "At"
  },
  {
   "default": "Monday",
   "depends_on": "eval:doc.sync_frequency === 'Weekly'",
   "fieldname": "sync_day_of_week",
   "fieldtype": "Select",
   "label": "On",
   "options": "Monday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.sync_frequency === 'Monthly'",
   "description": "Day of the month, 1 to 28.",
   "fieldname": "sync_day_of_month",
