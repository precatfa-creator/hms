   "fieldtype": "Section Break",
   "label": "Scheduled Sync"
  },
  {
   "default": "Never",
   "depends_on": "studbook_enabled",
   "description": "How often the studbook is read on its own. The button above always works regardless.",
   "fieldname": "sync_frequency",
   "fieldtype": "Select",
   "label": "Frequency",
   "options": "Never\nHourly\nDaily\nWeekly\nMonthly"
  },
  {
   "default": "00:00:00",
   "depends_on": "eval:['Daily', 'Weekly', 'Monthly'].includes(doc.sync_frequency)",
